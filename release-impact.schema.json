{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking-on-aspire.local/schemas/release-impact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marker", "inputs"],
        "properties": {
          "marker": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
