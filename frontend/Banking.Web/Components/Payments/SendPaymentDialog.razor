@inherits FluentDialogInstance
@inject BankingDashboardService DashboardService

<FluentDialogBody FixedHeaderFooter="true">
    <TitleTemplate>Send payment</TitleTemplate>
    <ChildContent>
        @if (_error is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
        }

        <EditForm Model="Model" OnValidSubmit="SubmitAsync" FormName="send-payment">
            <DataAnnotationsValidator />
            <FluentStack Orientation="Orientation.Vertical" Width="100%" VerticalGap="16px">
                <FluentStack Orientation="Orientation.Vertical" Width="100%">
                    <FluentSelect TOption="PaymentAccountOption" TValue="string"
                                  Class="dialog-form-control"
                                  Items="Accounts"
                                  Value="Model.SourceAccount"
                                  ValueChanged="SourceAccountChanged"
                                  OptionText="@(option => option.Label)"
                                  OptionValue="@(option => option.Name)"
                                  Label="From account" />
                    <ValidationMessage For="() => Model.SourceAccount" />
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" Width="100%">
                    <FluentSelect TOption="PaymentBeneficiaryOption" TValue="string"
                                  Class="dialog-form-control"
                                  Items="Beneficiaries"
                                  @bind-Value="Model.Beneficiary"
                                  OptionText="@(option => option.Label)"
                                  OptionValue="@(option => option.Name)"
                                  Label="Beneficiary" />
                    <ValidationMessage For="() => Model.Beneficiary" />
                </FluentStack>

                <FluentStack Width="100%" HorizontalGap="12px" VerticalGap="12px" Wrap="true">
                    <FluentStack Orientation="Orientation.Vertical" Class="dialog-form-row">
                        <FluentNumberInput TValue="decimal" @bind-Value="Model.Amount"
                                           Class="dialog-form-control"
                                           Label="Amount"
                                           Min="0.01m"
                                           Step="0.01m"
                                           Required="true" />
                        <ValidationMessage For="() => Model.Amount" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Vertical" Class="dialog-form-row">
                        <FluentTextInput @bind-Value="Model.CurrencyCode"
                                         Class="dialog-form-control"
                                         Label="Currency"
                                         ReadOnly="true" />
                    </FluentStack>
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" Width="100%">
                    <FluentTextArea @bind-Value="Model.Reference"
                                    Class="dialog-form-control"
                                    Label="Reference (optional)"
                                    Maxlength="140"
                                    Height="86px" />
                    <ValidationMessage For="() => Model.Reference" />
                </FluentStack>

                <FluentMessageBar Intent="MessageBarIntent.Info">
                    Payments are completed immediately in this learning flow. Internal destinations are credited atomically.
                </FluentMessageBar>

                <FluentStack Width="100%" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="12px" Wrap="true">
                    <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Subtle"
                                  Disabled="_saving" OnClick="CancelAsync">Cancel</FluentButton>
                    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="_saving">
                        @(_saving ? "Sending…" : "Send payment")
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </EditForm>
    </ChildContent>
</FluentDialogBody>

@code {
    [Parameter, EditorRequired] public SendPaymentCommand Model { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PaymentAccountOption> Accounts { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<PaymentBeneficiaryOption> Beneficiaries { get; set; } = [];

    private bool _saving;
    private string? _error;

    private async Task SubmitAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var payment = await DashboardService.SendPaymentAsync(Model);
            await DialogInstance.CloseAsync(DialogResult.Ok(payment));
        }
        catch (ReauthenticationRequiredException exception) { _error = exception.Message; }
        catch (Grpc.Core.RpcException exception)
        {
            _error = exception.StatusCode switch
            {
                Grpc.Core.StatusCode.PermissionDenied => "You don't have permission to send this payment.",
                Grpc.Core.StatusCode.NotFound => "The selected beneficiary or account no longer exists.",
                Grpc.Core.StatusCode.FailedPrecondition => exception.Status.Detail,
                Grpc.Core.StatusCode.InvalidArgument => exception.Status.Detail,
                Grpc.Core.StatusCode.AlreadyExists => "This payment request was already used with different details.",
                _ => "The payment could not be sent. Please try again."
            };
        }
        catch (Exception exception) { _error = $"The payment could not be sent: {exception.Message}"; }
        finally { _saving = false; }
    }

    private Task CancelAsync() => DialogInstance.CloseAsync(DialogResult.Cancel());

    private void SourceAccountChanged(string value)
    {
        Model.SourceAccount = value;
        var account = Accounts.FirstOrDefault(option => option.Name == value);
        if (account is not null) Model.CurrencyCode = account.CurrencyCode;
    }

    protected override Task OnActionClickedAsync(bool isPrimary) => Task.CompletedTask;
}
