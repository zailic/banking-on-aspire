@inherits LayoutComponentBase

<FluentProviders />

<FluentLayout Class="app-layout"
              Width="100%"
              Height="100dvh"
              GlobalScrollbar="false"
              MobileBreakdownWidth="0">
    <FluentLayoutItem Area="LayoutArea.Header" Class="layout-header" Height="52px">
        <AppHeader />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Class="navigation-region" Width="72px">
        <AppNavigation />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="content-region">
        <main class="shell">@Body</main>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred. <a href="." class="reload">Reload</a>
</div>
