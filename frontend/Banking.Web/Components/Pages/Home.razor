@page "/"
@attribute [Authorize]
@inject BankingDashboardService DashboardService
@inject IDialogService DialogService
@inject INotificationService NotificationService

<PageTitle>Overview · Banking on Aspire</PageTitle>


<FluentMessageBarProvider Section="HOME" />


@if (_error is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">
        @_error
        @if (_reauthenticationRequired)
        {
            <a class="message-action" href="/authentication/login?returnUrl=/">Sign in again</a>
        }
    </FluentMessageBar>
}
else if (_dashboard is null)
{
    <div class="loading">
        <FluentSpinner /> Loading your banking workspace…
    </div>
}
else
{
    <section class="dashboard-heading">
        <div>
            <p class="eyebrow">Overview</p>
            <h1>Good to see you, @FirstName</h1>
            <p>Here's what's happening in your banking workspace.</p>
        </div>
        <div class="dashboard-actions">
            <AuthorizeView Policy="AccountsDeposit">
                <Authorized>
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@DepositIcon()"
                                  Disabled="@(OpenAccounts == 0)" OnClick="OpenDepositDialogAsync">
                        Add funds
                    </FluentButton>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="PaymentsSend">
                <Authorized>
                    <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@SendIcon()"
                                  Disabled="@(!CanSendPayment)" OnClick="OpenPaymentDialogAsync">
                        Send payment
                    </FluentButton>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="AccountsCreate">
                <Authorized>
                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@AccountsIcon()"
                                  OnClick="OpenAccountDialogAsync">
                        Open account
                    </FluentButton>
                </Authorized>
            </AuthorizeView>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@AddIcon()" OnClick="OpenContactDialogAsync">
                Add beneficiary
            </FluentButton>
        </div>
    </section>

    <section class="summary-grid" aria-label="Workspace summary">
        <FluentCard class="summary-card">
            <div class="summary-icon">
                <FluentIcon Value="@ProfileIcon()" />
            </div>
            <div><span>Profile status</span><strong>@ProfileStatus</strong><small>@_dashboard.User.Email</small></div>
        </FluentCard>
        <FluentCard class="summary-card">
            <div class="summary-icon">
                <FluentIcon Value="@ContactsIcon()" />
            </div>
            <div>
                <span>Beneficiaries</span><strong>@_dashboard.Contacts.Count</strong><small>@InternalContacts internal ·
                @ExternalContacts external</small>
            </div>
        </FluentCard>
        <FluentCard class="summary-card">
            <div class="summary-icon">
                <FluentIcon Value="@AccountsIcon()" />
            </div>
            <div>
                <span>Accounts</span><strong>@_dashboard.Accounts.Count</strong><small>@OpenAccounts open · @ClosedAccounts
                closed</small>
            </div>
        </FluentCard>
    </section>

    <section class="dashboard-grid">
        <FluentCard class="dashboard-panel accounts-panel">
            <div class="panel-heading">
                <div>
                    <h2>Accounts</h2>
                    <p>Your balances and account details</p>
                </div>
                @if (_dashboard.Accounts.Count > 0)
                {
                    <span class="panel-count" aria-label="@($"{_dashboard.Accounts.Count} accounts")">
                        @_dashboard.Accounts.Count
                    </span>
                }
            </div>
            @if (_dashboard.Accounts.Count == 0)
            {
                <div class="panel-empty compact-empty">
                    <div class="empty-icon">
                        <FluentIcon Value="@AccountsIcon()" />
                    </div>
                    <strong>No accounts yet</strong>
                    <span>An administrator can open your first account.</span>
                </div>
            }
            else
            {
                <div class="compact-dashboard-list" role="list" aria-label="Accounts">
                    @foreach (var account in _dashboard.Accounts)
                    {
                        <div class="compact-dashboard-item" role="listitem">
                            <div class="compact-item-icon">
                                <FluentIcon Value="@AccountsIcon()" />
                            </div>
                            <div class="account-identity">
                                <strong>@account.DisplayName</strong>
                                <span>@AccountTypeLabel(account) · @MaskedAccountNumber(account.AccountNumber)</span>
                            </div>
                            <div class="compact-item-value">
                                <strong>@AvailableBalance(account)</strong>
                                <span class="status-text">@AccountStatusLabel(account)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </FluentCard>

        <FluentCard class="dashboard-panel activity-panel">
            <div class="panel-heading">
                <div>
                    <h2>Recent activity</h2>
                    <p>Your latest transactions and transfers</p>
                </div>
                @if (_dashboard.Transactions.Count > 0)
                {
                    <span class="panel-count" aria-label="@($"{_dashboard.Transactions.Count} recent transactions")">
                        @_dashboard.Transactions.Count
                    </span>
                }
            </div>
            @if (_dashboard.Transactions.Count == 0)
            {
                <div class="panel-empty compact-empty">
                    <div class="empty-icon">
                        <FluentIcon Value="@ActivityIcon()" />
                    </div>
                    <strong>No activity yet</strong>
                    <span>Your completed payments will appear here.</span>
                </div>
            }
            else
            {
                <div class="activity-list" role="list" aria-label="Recent transactions">
                    @foreach (var transaction in _dashboard.Transactions.Take(3))
                    {
                        <div class="activity-item" role="listitem">
                            <div class="activity-direction @DirectionClass(transaction)">
                                <FluentIcon Value="@DirectionIcon(transaction)" />
                            </div>
                            <div class="activity-copy">
                                <strong>@TransactionTitle(transaction)</strong>
                                <span>@TransactionSubtitle(transaction)</span>
                            </div>
                            <div class="activity-amount @DirectionClass(transaction)">
                                <strong>@TransactionAmount(transaction)</strong>
                                <span>@TransactionTime(transaction)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </FluentCard>

        <FluentCard class="dashboard-panel beneficiaries-panel" id="beneficiaries">
            <div class="panel-heading">
                <div>
                    <h2>Beneficiaries</h2>
                    <p>People and accounts you can pay</p>
                </div>
                <div class="panel-heading-actions">
                    @if (_dashboard.Contacts.Count > 0)
                    {
                        <span class="panel-count" aria-label="@($"{_dashboard.Contacts.Count} beneficiaries")">
                            @_dashboard.Contacts.Count
                        </span>
                    }
                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@AddIcon()"
                                  OnClick="OpenContactDialogAsync">Add</FluentButton>
                </div>
            </div>

            @if (_dashboard.Contacts.Count == 0)
            {
                <div class="panel-empty">
                    <strong>No beneficiaries saved</strong><span>Add one to prepare your first
                    transfer.</span>
                </div>
            }
            else
            {
                <div class="compact-dashboard-list" role="list" aria-label="Beneficiaries">
                    @foreach (var contact in _dashboard.Contacts)
                    {
                        <div class="compact-dashboard-item" role="listitem">
                            <div class="compact-item-icon">
                                <FluentIcon Value="@ContactsIcon()" />
                            </div>
                            <div class="beneficiary-identity">
                                <strong>@contact.DisplayName</strong>
                                <span title="@Destination(contact)">@Destination(contact)</span>
                            </div>
                            <span class="contact-type">@ContactType(contact)</span>
                        </div>
                    }
                </div>
            }
        </FluentCard>
    </section>
}

@code {
    private BankingDashboard? _dashboard;
    private string? _error;
    private bool _reauthenticationRequired;

    private string DisplayName => string.IsNullOrWhiteSpace(_dashboard?.User.DisplayName)
        ? _dashboard?.User.Username ?? "customer"
        : _dashboard.User.DisplayName;
    private string FirstName => DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ??
DisplayName;
    private string ProfileStatus => _dashboard!.User.Status.ToString().Replace("UserStatus", "");
    private int InternalContacts => _dashboard!.Contacts.Count(contact => contact.DestinationCase ==
Contact.DestinationOneofCase.InternalAccount);
    private int ExternalContacts => _dashboard!.Contacts.Count - InternalContacts;
    private int OpenAccounts => _dashboard!.Accounts.Count(account => account.Status == AccountStatus.Open);
    private int ClosedAccounts => _dashboard!.Accounts.Count(account => account.Status == AccountStatus.Closed);
    private bool CanSendPayment => _dashboard!.Accounts.Any(account => account.Status == AccountStatus.Open)
        && _dashboard.Contacts.Count > 0;
    protected override async Task OnInitializedAsync()
    {
        try { _dashboard = await DashboardService.LoadAsync(); }
        catch (ReauthenticationRequiredException exception)
        {
            _reauthenticationRequired = true;
            _error = exception.Message;
        }
        catch (Exception exception) { _error = $"We couldn't load your banking workspace: {exception.Message}"; }
    }

    private async Task OpenContactDialogAsync()
    {
        _error = null;
        _reauthenticationRequired = false;
        var model = new CreateContactCommand();
        var result = await DialogService.ShowDialogAsync<AddContactDialog>(options =>
        {
            options.Modal = true;
            options.Header.Title = "Add beneficiary";
            options.Header.CloseAction.Visible = true;
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Visible = false;
            options.Size = DialogSize.Medium;
            options.Parameters.Add(nameof(AddContactDialog.Model), model);
            options.Header.CloseAction.OnClickAsync = async (dialog) => await dialog.CloseAsync(DialogResult.Cancel());
        });

        if (!result.Cancelled && result.Value is Contact created)
        {
            _dashboard = await DashboardService.LoadAsync();
            await ShowMessageBarAsync(MessageBarIntent.Success, $"Beneficiary {created.DisplayName} was added.");
        }
    }

    private async Task OpenAccountDialogAsync()
    {
        _error = null;
        _reauthenticationRequired = false;
        var model = new CreateAccountCommand { Owner = _dashboard!.User.Name };
        var result = await DialogService.ShowDialogAsync<CreateAccountDialog>(options =>
        {
            options.Modal = true;
            options.Size = DialogSize.Medium;

            options.Header.Title = "Open account";
            options.Header.CloseAction.Visible = true;
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Visible = false;
            options.Header.CloseAction.OnClickAsync = async (dialog) => await dialog.CloseAsync(DialogResult.Cancel());
            options.Parameters.Add(nameof(CreateAccountDialog.Model), model);
        });

        if (!result.Cancelled && result.Value is Account created)
        {
            _dashboard = await DashboardService.LoadAsync();
            await ShowMessageBarAsync(MessageBarIntent.Success, $"Account {created.DisplayName} was opened. Number: {created.AccountNumber}.");
        }
    }

    private async Task OpenPaymentDialogAsync()
    {
        _error = null;
        _reauthenticationRequired = false;
        var accounts = _dashboard!.Accounts
            .Where(account => account.Status == AccountStatus.Open)
            .Select(account => new PaymentAccountOption(
                account.Name,
                $"{account.DisplayName} · {AvailableBalance(account)}",
                account.CurrencyCode))
            .ToArray();
        var beneficiaries = _dashboard.Contacts
            .Select(contact => new PaymentBeneficiaryOption(contact.Name, $"{contact.DisplayName} · {Destination(contact)}"))
            .ToArray();
        if (accounts.Length == 0 || beneficiaries.Length == 0) return;

        var model = new SendPaymentCommand
        {
            SourceAccount = accounts[0].Name,
            Beneficiary = beneficiaries[0].Name,
            CurrencyCode = accounts[0].CurrencyCode
        };
        var result = await DialogService.ShowDialogAsync<SendPaymentDialog>(options =>
        {
            options.Modal = true;
            options.Size = DialogSize.Medium;
            options.Header.Title = "Send payment";
            options.Header.CloseAction.Visible = true;
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Visible = false;
            options.Parameters.Add(nameof(SendPaymentDialog.Model), model);
            options.Parameters.Add(nameof(SendPaymentDialog.Accounts), accounts);
            options.Parameters.Add(nameof(SendPaymentDialog.Beneficiaries), beneficiaries);
            options.Header.CloseAction.OnClickAsync = async (dialog) => await dialog.CloseAsync(DialogResult.Cancel());
        });

        if (!result.Cancelled && result.Value is Payment payment)
        {
            await RefreshUntilActivityChangesAsync();
            await ShowMessageBarAsync(MessageBarIntent.Success, $"Payment {FormatMoney(payment.Amount)} was sent successfully.");
        }
    }

    private async Task OpenDepositDialogAsync()
    {
        _error = null;
        _reauthenticationRequired = false;
        var accounts = _dashboard!.Accounts
            .Where(account => account.Status == AccountStatus.Open)
            .Select(account => new PaymentAccountOption(
                account.Name,
                $"{account.DisplayName} · {AvailableBalance(account)}",
                account.CurrencyCode))
            .ToArray();
        if (accounts.Length == 0) return;

        var model = new DepositFundsCommand
        {
            Account = accounts[0].Name,
            CurrencyCode = accounts[0].CurrencyCode
        };
        var result = await DialogService.ShowDialogAsync<DepositFundsDialog>(options =>
        {
            options.Modal = true;
            options.Size = DialogSize.Medium;
            options.Header.Title = "Add funds";
            options.Header.CloseAction.Visible = true;
            options.Footer.PrimaryAction.Visible = false;
            options.Footer.SecondaryAction.Visible = false;
            options.Parameters.Add(nameof(DepositFundsDialog.Model), model);
            options.Parameters.Add(nameof(DepositFundsDialog.Accounts), accounts);
            options.Header.CloseAction.OnClickAsync = async (dialog) => await dialog.CloseAsync(DialogResult.Cancel());
        });

        if (!result.Cancelled && result.Value is Deposit deposit)
        {
            await RefreshUntilActivityChangesAsync();
            await ShowMessageBarAsync(MessageBarIntent.Success, $"{FormatMoney(deposit.Amount)} was added to the account.");
        }
    }

    private async Task RefreshUntilActivityChangesAsync()
    {
        var knownTransactions = _dashboard?.Transactions
            .Select(transaction => transaction.Name)
            .ToHashSet() ?? [];

        for (var attempt = 0; attempt < 5; attempt++)
        {
            var refreshed = await DashboardService.LoadAsync();
            _dashboard = refreshed;

            if (refreshed.Transactions.Any(transaction => !knownTransactions.Contains(transaction.Name)))
            {
                return;
            }

            await Task.Delay(250 * (attempt + 1));
        }
    }

    private async Task ShowMessageBarAsync(MessageBarIntent intent, string title, double lifetimeInSeconds = 10)
    {
        await NotificationService.ShowMessageBarAsync(options =>
        {
            options.Section = "HOME";
            options.Intent = intent;
            options.Title = title;
            options.Lifetime = TimeSpan.FromSeconds(lifetimeInSeconds);
            options.ResultTiming = MessageBarResultTiming.Visible;
        });
    }

    private static string MaskedAccountNumber(string accountNumber)
    {
        if (string.IsNullOrWhiteSpace(accountNumber)) return "Number unavailable";
        var visibleLength = Math.Min(4, accountNumber.Length);
        return $"•••• {accountNumber[^visibleLength..]}";
    }

    private static string AvailableBalance(Account account)
    {
        if (account.AvailableBalance is null) return $"0.00 {account.CurrencyCode}";
        var amount = account.AvailableBalance.Units + account.AvailableBalance.Nanos / 1_000_000_000m;
        var currency = string.IsNullOrWhiteSpace(account.AvailableBalance.CurrencyCode)
            ? account.CurrencyCode
            : account.AvailableBalance.CurrencyCode;
        return $"{amount:N2} {currency}";
    }

    private static string AccountTypeLabel(Account account) => account.Type switch
    {
        AccountType.Checking => "Checking",
        AccountType.Savings => "Savings",
        _ => "Unknown"
    };

    private static string AccountStatusLabel(Account account) => account.Status switch
    {
        AccountStatus.Open => "Open",
        AccountStatus.Frozen => "Frozen",
        AccountStatus.Closed => "Closed",
        _ => "Unknown"
    };

    private static string Destination(Contact contact) => contact.DestinationCase switch
    {
        Contact.DestinationOneofCase.InternalAccount => contact.InternalAccount,
        Contact.DestinationOneofCase.ExternalAccount =>
            $"External · ••••{contact.ExternalAccount.AccountNumber[^Math.Min(4, contact.ExternalAccount.AccountNumber.Length)..]}",
        _ => "Destination unavailable"
    };

    private static string ContactType(Contact contact) => contact.DestinationCase ==
Contact.DestinationOneofCase.InternalAccount ? "Internal" : "External";
    private string TransactionTitle(Transaction transaction)
    {
        if (!string.IsNullOrWhiteSpace(transaction.Reference)) return transaction.Reference;
        var contact = _dashboard!.Contacts.FirstOrDefault(item => item.Name == transaction.Counterparty);
        return contact?.DisplayName ?? (transaction.Direction == TransactionDirection.Credit ? "Payment received" : "Payment sent");
    }
    private static string TransactionSubtitle(Transaction transaction) =>
        transaction.Direction == TransactionDirection.Credit ? "Incoming payment" : "Outgoing payment";
    private static string TransactionAmount(Transaction transaction) =>
        $"{(transaction.Direction == TransactionDirection.Credit ? "+" : "−")}{FormatMoney(transaction.Amount)}";
    private static string FormatMoney(Google.Type.Money? money)
    {
        if (money is null) return "0.00";
        var amount = money.Units + money.Nanos / 1_000_000_000m;
        return $"{amount:N2} {money.CurrencyCode}";
    }
    private static string TransactionTime(Transaction transaction) =>
        transaction.CreateTime?.ToDateTime().ToLocalTime().ToString("dd MMM, HH:mm") ?? "";
    private static string DirectionClass(Transaction transaction) =>
        transaction.Direction == TransactionDirection.Credit ? "credit" : "debit";
    private static Icon DirectionIcon(Transaction transaction) => transaction.Direction == TransactionDirection.Credit
        ? new Icons.Regular.Size20.ArrowDown()
        : new Icons.Regular.Size20.ArrowUp();
    private static Icon AddIcon() => new Icons.Regular.Size20.Add();
    private static Icon DepositIcon() => new Icons.Regular.Size20.ArrowDownload();
    private static Icon SendIcon() => new Icons.Regular.Size20.Send();
    private static Icon ProfileIcon() => new Icons.Regular.Size24.Person();
    private static Icon ContactsIcon() => new Icons.Regular.Size24.People();
    private static Icon AccountsIcon() => new Icons.Regular.Size24.Wallet();
    private static Icon ActivityIcon() => new Icons.Regular.Size24.ArrowTrendingLines();
}
